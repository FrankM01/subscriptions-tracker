# Copia este archivo a .env y reemplaza cada valor por una credencial local.
# No reutilices estas credenciales fuera de tu equipo.

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-this-postgres-password

APP_DB_NAME=subscriptions
APP_DB_USER=subscriptions_app
APP_DB_PASSWORD=change-this-app-password

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=change-this-keycloak-db-password

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-admin-password

# OIDC local. Conserva estos IDs o actualiza también keycloak/realms/subscriptions-realm.json.
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8081
KEYCLOAK_REALM=subscriptions
KEYCLOAK_WEB_CLIENT_ID=subscriptions-web
KEYCLOAK_ISSUER_URL=http://127.0.0.1:8081/realms/subscriptions
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/subscriptions/protocol/openid-connect/certs
KEYCLOAK_API_AUDIENCE=subscriptions-api

POSTGRES_HOST_PORT=5432
APP_HOST_PORT=8000
KEYCLOAK_HOST_PORT=8081
